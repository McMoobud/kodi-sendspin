<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="service.sendspin">
        <category id="general" label="30000">
            <group id="1">
                <setting id="enabled" type="boolean" label="30001" help="30101">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="player_name" type="string" label="30002" help="30102">
                    <level>0</level>
                    <default></default>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="edit" format="string"><heading>30002</heading></control>
                </setting>
                <setting id="server_url" type="string" label="30003" help="30103">
                    <level>0</level>
                    <default></default>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="edit" format="string"><heading>30003</heading></control>
                </setting>
                <setting id="yield_to_video" type="boolean" label="30004" help="30104">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="remote_skip" type="boolean" label="30006" help="30106">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="notifications" type="boolean" label="30005" help="30105">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
        <category id="security" label="30020">
            <group id="1">
                <setting id="connection" type="integer" label="30007" help="30107">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30030">0</option>
                            <option label="30031">1</option>
                            <option label="30032">2</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"><heading>30007</heading></control>
                </setting>
                <setting id="unpaired_access" type="boolean" label="30008" help="30108">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="show_token" type="action" label="30021" help="30121">
                    <level>0</level>
                    <data>RunScript(special://home/addons/service.sendspin/actions.py,show_token)</data>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="button" format="action"><close>true</close></control>
                </setting>
                <setting id="forget_pairings" type="action" label="30022" help="30122">
                    <level>0</level>
                    <data>RunScript(special://home/addons/service.sendspin/actions.py,forget_pairings)</data>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="button" format="action"><close>true</close></control>
                </setting>
            </group>
